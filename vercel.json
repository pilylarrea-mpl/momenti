{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/vid/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/house",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/instagram",
      "destination": "/?utm_source=instagram&utm_medium=organic_social&utm_campaign=profile&utm_content=bio",
      "permanent": false
    },
    {
      "source": "/tiktok",
      "destination": "/?utm_source=tiktok&utm_medium=organic_social&utm_campaign=profile&utm_content=bio",
      "permanent": false
    }
  ]
}
